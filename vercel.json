{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "teacher/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "student/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "parent/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "accountant/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/teacher/(.*)",
      "dest": "/teacher/$1"
    },
    {
      "src": "/student/(.*)",
      "dest": "/student/$1"
    },
    {
      "src": "/parent/(.*)",
      "dest": "/parent/$1"
    },
    {
      "src": "/accountant/(.*)",
      "dest": "/accountant/$1"
    },
    {
      "src": "/(login|logout|profile|security|setup_admin|set_password|verify_otp|forgot_password|reset_password|request_access)",
      "dest": "/$1.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/$1"
    }
  ]
}
